<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_sky_gray"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp">

        <!-- Header Superior -->
        <LinearLayout
            android:id="@+id/headerBookForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_header"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pink"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:text="GESTIÓN DE LECTURA"
                        android:textColor="@color/dark_night"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Registrar Libro"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Eliminar (visible en modo edición) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteBook"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Eliminar"
                    android:textAllCaps="false"
                    android:textColor="@color/status_error"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/pearl_pink"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_delete"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/status_error" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta Principal del Formulario -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBookForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-28dp"
            app:cardBackgroundColor="@color/surface_card_elevated"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBookForm"
            app:strokeColor="@color/ice_cyan"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- 1. Título del Libro -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTitle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título del libro (2 a 60 caracteres) *"
                    app:boxBackgroundColor="@color/surface_input"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/deep_teal"
                    app:counterEnabled="true"
                    app:counterMaxLength="60"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:textColor="@color/dark_night" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Autor del Libro -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAuthor"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Autor (2 a 60 caracteres) *"
                    app:boxBackgroundColor="@color/surface_input"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/deep_teal"
                    app:counterEnabled="true"
                    app:counterMaxLength="60"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/dark_night" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Género (4 obligatorios: Novela, Ciencia ficción, Historia, Desarrollo personal) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGenre"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Género literario *"
                    app:boxBackgroundColor="@color/surface_input"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/deep_teal"
                    app:errorEnabled="true">

                    <AutoCompleteTextView
                        android:id="@+id/actvGenre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/dark_night" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. Total de páginas y Páginas leídas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTotalPages"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Total páginas *"
                        app:boxBackgroundColor="@color/surface_input"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/deep_teal"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTotalPages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/dark_night" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilReadPages"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Páginas leídas *"
                        app:boxBackgroundColor="@color/surface_input"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/deep_teal"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReadPages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/dark_night" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Vista previa de avance de lectura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_metric_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPreviewLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Porcentaje de avance calculado"
                            android:textColor="@color/steel_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pink"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:text="0%"
                            android:textColor="@color/dark_night"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/accent_turquoise"
                        app:trackColor="@color/ice_cyan"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="7dp" />
                </LinearLayout>

                <!-- 5. Estado del Libro (Por leer, Leyendo, Terminado) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Estado de lectura *"
                    android:textColor="@color/dark_night"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipToRead"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Por leer"
                        android:textColor="@color/dark_night"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/ice_cyan" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReading"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leyendo"
                        android:textColor="@color/dark_night"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/ice_cyan" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFinished"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terminado"
                        android:textColor="@color/dark_night"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/ice_cyan" />
                </com.google.android.material.chip.ChipGroup>

                <!-- 6. Calificación (1 a 5 estrellas, solo si el estado es Terminado) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRatingSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_input"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_soft"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvRatingHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calificación del libro (1 a 5 estrellas)"
                            android:textColor="@color/dark_night"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRatingHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Solo disponible y obligatoria cuando el estado es &quot;Terminado&quot;"
                            android:textColor="@color/warm_taupe"
                            android:textSize="12sp" />

                        <RatingBar
                            android:id="@+id/ratingBarBook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/star_gold"
                            android:secondaryProgressTint="@color/star_gold"
                            android:stepSize="1.0" />

                        <TextView
                            android:id="@+id/tvRatingValueLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sin calificación (libro no terminado)"
                            android:textColor="@color/steel_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRatingError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textColor="@color/status_error"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <!-- Fecha de finalización automática -->
                        <LinearLayout
                            android:id="@+id/layoutFinishedDateInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_badge_pink"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Fecha de finalización"
                                android:src="@drawable/ic_calendar" />

                            <TextView
                                android:id="@+id/tvFinishedDateText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Fecha de término: Se registrará hoy"
                                android:textColor="@color/dark_night"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Indicador de carga -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/accent_turquoise"
                    app:trackColor="@color/ice_cyan" />

                <!-- Botón Guardar Libro -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveBook"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="Guardar Libro"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/deep_teal"
                    app:cornerRadius="14dp"
                    app:elevation="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
