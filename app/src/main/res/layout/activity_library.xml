<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_sky_gray">

    <!-- Header Superior -->
    <LinearLayout
        android:id="@+id/headerLibrary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_header"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pink"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="COLECCIÓN PERSONAL"
                    android:textColor="@color/dark_night"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mi Biblioteca"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLibrarySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 libros registrados"
                    android:textColor="@color/ice_cyan"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBookLibrary"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Nuevo"
                android:textAllCaps="false"
                android:textColor="@color/dark_night"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ice_cyan"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="@color/deep_teal" />
        </LinearLayout>

        <!-- Filtros rápidos por estado -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todos"
                    android:textColor="@color/dark_night"
                    app:chipBackgroundColor="@color/ice_cyan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterReading"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leyendo"
                    android:textColor="@color/dark_night"
                    app:chipBackgroundColor="@color/ice_cyan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFinished"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminados"
                    android:textColor="@color/dark_night"
                    app:chipBackgroundColor="@color/ice_cyan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterToRead"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por leer"
                    android:textColor="@color/dark_night"
                    app:chipBackgroundColor="@color/ice_cyan" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Lista Desplazable de Todos los Libros -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryBooks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLibrary" />

    <!-- Estado Vacío cuando no hay libros que mostrar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmptyLibrary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="36dp"
        app:cardBackgroundColor="@color/surface_card_elevated"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLibrary"
        app:strokeColor="@color/ice_cyan"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Biblioteca vacía"
                    android:src="@drawable/ic_library" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmptyLibraryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tu biblioteca está vacía"
                android:textColor="@color/dark_night"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyLibraryMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Aún no hay libros registrados en tu cuenta. Agrega tu primer libro para comenzar tu seguimiento de lectura."
                android:textColor="@color/warm_taupe"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAddBook"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="20dp"
                android:text="Agregar mi primer libro"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/deep_teal"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
